{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "require_code_owner_review": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "ci / Pre-commit Checks", "integration_id": 15368 },
          { "context": "ci / Lint & Format", "integration_id": 15368 },
          { "context": "ci / Build", "integration_id": 15368 },
          { "context": "ci / Build no_std (bare-metal)", "integration_id": 15368 },
          { "context": "ci / Unit Tests", "integration_id": 15368 },
          { "context": "ci / Property Tests", "integration_id": 15368 },
          { "context": "ci / Miri Tests", "integration_id": 15368 },
          { "context": "ci / Check MSRV", "integration_id": 15368 },
          { "context": "ci / Security Audit", "integration_id": 15368 },
          { "context": "ci / Documentation", "integration_id": 15368 },
          { "context": "ci / Publish Dry Run", "integration_id": 15368 },
          { "context": "Fuzz Tests (uds_protocol)", "integration_id": 15368 },
          { "context": "Fuzz Tests (simple_doip)", "integration_id": 15368 },
          { "context": "needs", "integration_id": 15368 },
          { "context": "PR Title Lint", "integration_id": 15368 },
          { "context": "PR Description Lint", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "grouping_strategy": "ALLGREEN",
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "max_entries_to_build": 5,
        "min_entries_to_merge_wait_minutes": 0,
        "check_response_timeout_minutes": 60
      }
    }
  ]
}
